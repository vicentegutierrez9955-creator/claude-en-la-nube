# Base de datos Postgres (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://usuario:clave@host:5432/pedidos"

# URL pública de la app (se usa para los webhooks y links de pago)
APP_URL="https://tu-app.vercel.app"

# Secreto para firmar sesiones (genera uno con: openssl rand -hex 32)
SESSION_SECRET=""

# Llave para cifrar los tokens de cada pyme en la base de datos (openssl rand -hex 32)
ENCRYPTION_KEY=""

# Claude (Anthropic) — el cerebro del vendedor automático
ANTHROPIC_API_KEY=""
# Opcional: modelo y esfuerzo
CLAUDE_MODEL="claude-opus-5-5"
CLAUDE_EFFORT="medium"

# WhatsApp Cloud API (Meta) — token de verificación del webhook (lo inventas tú)
WHATSAPP_VERIFY_TOKEN=""
# Secreto de la app de Meta, para validar la firma de los webhooks
WHATSAPP_APP_SECRET=""
