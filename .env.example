# Base de datos Postgres (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://usuario:clave@host:5432/pedidos"

# URL pública de la app (se usa para los webhooks y links de pago)
APP_URL="https://tu-app.vercel.app"

# Secreto para firmar sesiones (genera uno con: openssl rand -hex 32)
SESSION_SECRET=""

# Llave para cifrar los tokens de cada pyme en la base de datos (openssl rand -hex 32)
ENCRYPTION_KEY=""

# ---------- IA ----------
# DeepSeek (por defecto). La clave se crea en platform.deepseek.com
DEEPSEEK_API_KEY=""
# Modelo por defecto: deepseek-v4-flash (económico) o deepseek-v4-pro.
# Cada tienda puede tener otro desde /admin.
AI_MODEL="deepseek-v4-flash"
# Opcional: Claude (Anthropic), si en /admin eliges un modelo de Claude para alguna tienda
ANTHROPIC_API_KEY=""
AI_EFFORT="medium"

# ---------- WhatsApp (app de Meta del SaaS) ----------
# Para el botón "Conectar WhatsApp" (Embedded Signup). Ver README → "Lo que hay que configurar en Meta".
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
# Token de verificación del webhook (lo inventas tú y lo pegas también en Meta)
WHATSAPP_VERIFY_TOKEN=""
# Horas que el vendedor IA se pausa en un chat cuando el dueño responde desde su celular
OWNER_PAUSE_HOURS="12"

# ---------- Administración ----------
# Correos de los administradores del SaaS (ven /admin: consumo de IA de todas las tiendas,
# modelo y tope mensual de cada una). Separados por coma.
ADMIN_EMAILS=""
# Tipo de cambio para mostrar costos en pesos
USD_CLP="950"
