{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth/metadatos"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth/recurso"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth/recurso"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "asesoriascontables-jc.cl"
        }
      ],
      "destination": "/asesorias-contables-jc"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.asesoriascontables-jc.cl"
        }
      ],
      "destination": "/asesorias-contables-jc"
    },
    {
      "source": "/barrio/:paso",
      "destination": "/barrio"
    },
    {
      "source": "/premium/:paso",
      "destination": "/premium"
    },
    {
      "source": "/urbana/:paso",
      "destination": "/urbana"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(panel|api/panel|api/oauth|api/mcp)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/panel/correo",
      "schedule": "0 12 * * *"
    }
  ]
}
